  "keywords": [
    "kikito",
    "ui",
    "components",
    "cli",
    "design-system",
    "tailwindcss",
    "react",
    "nextjs",
    "framer-motion",
    "animation",
    "component-library"
  ],
  "homepage": "https://kikito-tv-oficial.vercel.app/pt",
  "repository": {
    "type": "git",
