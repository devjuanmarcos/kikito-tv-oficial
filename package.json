{
  "name": "biomob-next-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "registry:build": "node scripts/build-registry.mjs",
    "registry:watch": "node --watch scripts/build-registry.mjs",
    "cli:build": "pnpm --filter kikitocn build",
    "cli:dev": "pnpm --filter kikitocn dev",
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --reporter=verbose --coverage",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:all": "vitest run && playwright test",
    "analyze": "cross-env ANALYZE=true pnpm build",
    "knip": "knip",
    "secretlint": "secretlint \"**/*\"",
    "security:audit": "pnpm audit --audit-level=moderate",
    "docker:build": "docker build -t portal-pwa .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.local portal-pwa",
    "docker:compose": "docker-compose up"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
