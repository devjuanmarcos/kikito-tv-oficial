# ─── Autenticação ────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-with-at-least-16-chars
NEXTAUTH_URL=http://localhost:3000

# ─── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── APIs Externas ───────────────────────────────────────────────────────────
BASE_URL_BIOCONECTA=https://api.biomoborg.biomob.app
# BASE_URL_API=https://api.seudominio.com.br

# ─── Build / CI ──────────────────────────────────────────────────────────────
# Pular validação de env durante CI: SKIP_ENV_VALIDATION=true
